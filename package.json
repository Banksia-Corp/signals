{
  "name": "@banksia/signals",
  "version": "0.1.5",
  "packageManager": "pnpm@10.28.0",
  "description": "Ultra-fast reactivity engine for the modern web with pure domain models, multi-framework adapters (React, Lit, SolidJS, Vanilla DOM), and first-class observability",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./lit": {
      "types": "./dist/lit.d.ts",
      "import": "./dist/lit.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "docs": "typedoc",
    "docs:api": "typedoc",
    "docs:dev": "rspress dev",
    "docs:build": "typedoc && rspress build && node scripts/docs-postbuild.mjs",
    "docs:preview": "rspress preview",
    "docs:watch": "typedoc --watch",
    "format": "prettier --write .",
    "lint": "prettier --check \"src/**/*\" \"tests/**/*\" \"docs/**/*\" README.md AGENTS.md",
    "size": "rslib build && node scripts/check-size-budgets.mjs",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "release": "pnpm run build && changeset publish",
    "prepare": "lefthook install"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Banksia-Corp/signals.git"
  },
  "bugs": {
    "url": "https://github.com/Banksia-Corp/signals/issues"
  },
  "homepage": "https://github.com/Banksia-Corp/signals#readme",
  "license": "MIT",
  "peerDependencies": {
    "lit": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.27.1",
    "@rslib/core": "^0.23.2",
    "@rspress/plugin-typedoc": "1.47.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "lefthook": "^2.1.10",
    "lit": "^3.2.1",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "rspress": "1.47.2",
    "solid-js": "^1.9.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
